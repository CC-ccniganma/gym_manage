<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.milotnt.mapper.SuperSiteReservationMapper">

    <!-- 查询所有预约记录 -->
    <select id="findAll" resultType="com.milotnt.pojo.SuperSiteReservation">
        SELECT * FROM super_site_reservation
    </select>

    <!-- 添加预约记录 -->
    <insert id="insertSuperSiteReservation" parameterType="com.milotnt.pojo.SuperSiteReservation">
        INSERT INTO super_site_reservation (reservation_date, period, member_account)
        VALUES (#{reservationDate}, #{period}, #{memberAccount})
    </insert>

    <!-- 根据会员账号和日期删除预约 -->
    <delete id="deleteByMemberAccountAndReservationDate">
        DELETE FROM super_site_reservation
        WHERE member_account = #{memberAccount} AND reservation_date = #{reservationDate}
    </delete>

    <!-- 根据会员账号和日期查询预约 -->
    <select id="selectByMemberAccountAndReservationDate" parameterType="com.milotnt.pojo.SuperSiteReservation" resultType="com.milotnt.pojo.SuperSiteReservation">
        SELECT * FROM super_site_reservation
        WHERE member_account = #{memberAccount}
    </select>

    <!-- 统计特定日期和时段的预约人数 -->
    <select id="countByDateAndPeriod" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM super_site_reservation
        WHERE reservation_date = #{reservationDate} AND period = #{period}
    </select>

</mapper> 