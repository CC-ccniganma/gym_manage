<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.milotnt.mapper.CoachMapper">

    
    <select id="findAll" resultType="com.milotnt.pojo.Coach">
        SELECT *
        FROM coach
    </select>

    <insert id="insertCoach" parameterType="coach">
        INSERT INTO coach (coach_account, coach_name, coach_gender, coach_age)
        VALUES (#{coachAccount}, #{coachName}, #{coachGender}, #{coachAge})
    </insert>

    <update id="updateCoachByCoachAccount" parameterType="coach">
        UPDATE coach
        SET coach_account  = #{coachAccount},
        coach_password = #{coachPassword},
        coach_name     = #{coachName},
        coach_gender   = #{coachGender},
        coach_age      = #{coachAge}
        WHERE coach_account = #{coachAccount}
    </update>

    <select id="selectByAccountAndPassword" resultType="coach">
        SELECT *
        FROM coach
        WHERE coach_account = #{coachAccount}
    </select>

    <delete id="deleteByCoachAccount" parameterType="java.lang.Integer">
        DELETE
        FROM coach
        WHERE coach_account = #{coachAccount}
    </delete>

    <select id="selectByCoachAccount" parameterType="java.lang.Integer" resultType="coach">
        SELECT *
        FROM coach
        WHERE coach_account = #{coachAccount}
    </select>

</mapper>